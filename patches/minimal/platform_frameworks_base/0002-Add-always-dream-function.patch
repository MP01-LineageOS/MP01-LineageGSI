From 8c04c5248b113910545ae5ba304bc0928437fe27 Mon Sep 17 00:00:00 2001
From: Charlie Mizutsuki <charlie.mizutsuki@posteo.net>
Date: Mon, 11 Aug 2025 09:20:20 +0000
Subject: [PATCH 1/2] Add always dream function

Change-Id: Iaffef56d3907472af56eb1994642aa41936f2f8d
---
 .../settingslib/dream/DreamBackend.java       | 20 ++++++++++-
 .../server/dreams/DreamManagerService.java    | 35 +++++++++++++------
 2 files changed, 44 insertions(+), 11 deletions(-)

diff --git a/packages/SettingsLib/src/com/android/settingslib/dream/DreamBackend.java b/packages/SettingsLib/src/com/android/settingslib/dream/DreamBackend.java
index dc40304ba24a..b7afeac2539a 100644
--- a/packages/SettingsLib/src/com/android/settingslib/dream/DreamBackend.java
+++ b/packages/SettingsLib/src/com/android/settingslib/dream/DreamBackend.java
@@ -78,7 +78,7 @@ public class DreamBackend {
     }
 
     @Retention(RetentionPolicy.SOURCE)
-    @IntDef({WHILE_CHARGING, WHILE_DOCKED, EITHER, NEVER})
+    @IntDef({WHILE_CHARGING, WHILE_DOCKED, EITHER, NEVER, ALWAYS})
     public @interface WhenToDream {
     }
 
@@ -86,6 +86,7 @@ public class DreamBackend {
     public static final int WHILE_DOCKED = 1;
     public static final int EITHER = 2;
     public static final int NEVER = 3;
+    public static final int ALWAYS = 4;
 
     /**
      * The type of dream complications which can be provided by a
@@ -136,6 +137,8 @@ public class DreamBackend {
             .DREAM_SETTING_CHANGED__WHEN_TO_DREAM__WHEN_TO_DREAM_WHILE_DOCKED_ONLY;
     private static final int WHEN_TO_DREAM_CHARGING_OR_DOCKED = FrameworkStatsLog
             .DREAM_SETTING_CHANGED__WHEN_TO_DREAM__WHEN_TO_DREAM_EITHER_CHARGING_OR_DOCKED;
+    private static final int WHEN_TO_DREAM_ALWAYS = FrameworkStatsLog
+            .DREAM_SETTING_CHANGED__WHEN_TO_DREAM__WHEN_TO_DREAM_EITHER_CHARGING_OR_DOCKED; // Use same as EITHER for now
 
     private final Context mContext;
     private final IDreamManager mDreamManager;
@@ -280,6 +283,10 @@ public class DreamBackend {
 
     @WhenToDream
     public int getWhenToDreamSetting() {
+        // Check if ALWAYS is set first
+        if (getBoolean(Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, 0)) {
+            return ALWAYS;
+        }
         return isActivatedOnDock() && isActivatedOnSleep() ? EITHER
                 : isActivatedOnDock() ? WHILE_DOCKED
                         : isActivatedOnSleep() ? WHILE_CHARGING
@@ -293,16 +300,25 @@ public class DreamBackend {
             case WHILE_CHARGING:
                 setActivatedOnDock(false);
                 setActivatedOnSleep(true);
+                setBoolean(Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, false);
                 break;
 
             case WHILE_DOCKED:
                 setActivatedOnDock(true);
                 setActivatedOnSleep(false);
+                setBoolean(Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, false);
                 break;
 
             case EITHER:
                 setActivatedOnDock(true);
                 setActivatedOnSleep(true);
+                setBoolean(Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, false);
+                break;
+
+            case ALWAYS:
+                setActivatedOnDock(true);
+                setActivatedOnSleep(true);
+                setBoolean(Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, true);
                 break;
 
             case NEVER:
@@ -550,6 +566,8 @@ public class DreamBackend {
                 return WHEN_TO_DREAM_DOCKED;
             case EITHER:
                 return WHEN_TO_DREAM_CHARGING_OR_DOCKED;
+            case ALWAYS:
+                return WHEN_TO_DREAM_ALWAYS;
             case NEVER:
             default:
                 return WHEN_TO_DREAM_UNSPECIFIED;
diff --git a/services/core/java/com/android/server/dreams/DreamManagerService.java b/services/core/java/com/android/server/dreams/DreamManagerService.java
index 0c04be10d06d..9d61a8308652 100644
--- a/services/core/java/com/android/server/dreams/DreamManagerService.java
+++ b/services/core/java/com/android/server/dreams/DreamManagerService.java
@@ -110,12 +110,13 @@ public final class DreamManagerService extends SystemService {
 
     /** Constants for the when to activate dreams. */
     @Retention(RetentionPolicy.SOURCE)
-    @IntDef({DREAM_ON_DOCK, DREAM_ON_CHARGE, DREAM_ON_DOCK_OR_CHARGE})
+    @IntDef({DREAM_ON_DOCK, DREAM_ON_CHARGE, DREAM_ON_DOCK_OR_CHARGE, DREAM_ALWAYS})
     public @interface WhenToDream {}
     private static final int DREAM_DISABLED = 0x0;
     private static final int DREAM_ON_DOCK = 0x1;
     private static final int DREAM_ON_CHARGE = 0x2;
     private static final int DREAM_ON_DOCK_OR_CHARGE = 0x3;
+    private static final int DREAM_ALWAYS = 0x4;
 
     private final Object mLock = new Object();
 
@@ -409,15 +410,25 @@ public final class DreamManagerService extends SystemService {
         synchronized (mLock) {
             final ContentResolver resolver = mContext.getContentResolver();
 
-            final int activateWhenCharging = (Settings.Secure.getIntForUser(resolver,
-                    Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP,
-                    mDreamsActivatedOnChargeByDefault ? 1 : 0,
-                    UserHandle.USER_CURRENT) != 0) ? DREAM_ON_CHARGE : DREAM_DISABLED;
-            final int activateWhenDocked = (Settings.Secure.getIntForUser(resolver,
-                    Settings.Secure.SCREENSAVER_ACTIVATE_ON_DOCK,
-                    mDreamsActivatedOnDockByDefault ? 1 : 0,
-                    UserHandle.USER_CURRENT) != 0) ? DREAM_ON_DOCK : DREAM_DISABLED;
-            mWhenToDream = activateWhenCharging + activateWhenDocked;
+            // Check if ALWAYS is enabled first
+            final boolean activateAlways = (Settings.Secure.getIntForUser(resolver,
+                    Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS,
+                    0,
+                    UserHandle.USER_CURRENT) != 0);
+            
+            if (activateAlways) {
+                mWhenToDream = DREAM_ALWAYS;
+            } else {
+                final int activateWhenCharging = (Settings.Secure.getIntForUser(resolver,
+                        Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP,
+                        mDreamsActivatedOnChargeByDefault ? 1 : 0,
+                        UserHandle.USER_CURRENT) != 0) ? DREAM_ON_CHARGE : DREAM_DISABLED;
+                final int activateWhenDocked = (Settings.Secure.getIntForUser(resolver,
+                        Settings.Secure.SCREENSAVER_ACTIVATE_ON_DOCK,
+                        mDreamsActivatedOnDockByDefault ? 1 : 0,
+                        UserHandle.USER_CURRENT) != 0) ? DREAM_ON_DOCK : DREAM_DISABLED;
+                mWhenToDream = activateWhenCharging + activateWhenDocked;
+            }
 
             mDreamsEnabledSetting = (Settings.Secure.getIntForUser(resolver,
                     Settings.Secure.SCREENSAVER_ENABLED,
@@ -500,6 +511,10 @@ public final class DreamManagerService extends SystemService {
                 return false;
             }
 
+            if (mWhenToDream == DREAM_ALWAYS) {
+                return true;
+            }
+
             if ((mWhenToDream & DREAM_ON_CHARGE) == DREAM_ON_CHARGE) {
                 return mIsCharging;
             }
-- 
2.43.0


From 922d83cecd11a448234fd91a80ae2da0b64a6fde Mon Sep 17 00:00:00 2001
From: Charlie Mizutsuki <charlie.mizutsuki@posteo.net>
Date: Mon, 11 Aug 2025 09:44:57 +0000
Subject: [PATCH 2/2] Add SCREENSAVER_ACTIVATE_ALWAYS constant and related
 infrastructure

Change-Id: I0f54e08d081142bf44cc02622f59969152c13c54
---
 core/java/android/provider/Settings.java                  | 8 ++++++++
 .../android/provider/settings/backup/SecureSettings.java  | 1 +
 .../settings/validators/SecureSettingsValidators.java     | 1 +
 .../com/android/providers/settings/DatabaseHelper.java    | 1 +
 .../android/providers/settings/SettingsProtoDumpUtil.java | 3 +++
 5 files changed, 14 insertions(+)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 0dd963457087..25c471ce7ada 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -10486,6 +10486,14 @@ public final class Settings {
         @Readable
         public static final String SCREENSAVER_ACTIVATE_ON_SLEEP = "screensaver_activate_on_sleep";
 
+        /**
+         * If screensavers are enabled, whether the screensaver should be automatically launched
+         * always when the device is locked.
+         * @hide
+         */
+        @Readable
+        public static final String SCREENSAVER_ACTIVATE_ALWAYS = "screensaver_activate_always";
+
         /**
          * If screensavers are enabled, the default screensaver component.
          * @hide
diff --git a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
index 0944766d4ca7..727163aca4f4 100644
--- a/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
+++ b/packages/SettingsProvider/src/android/provider/settings/backup/SecureSettings.java
@@ -153,6 +153,7 @@ public class SecureSettings {
         Settings.Secure.SCREENSAVER_COMPONENTS,
         Settings.Secure.SCREENSAVER_ACTIVATE_ON_DOCK,
         Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP,
+        Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS,
         Settings.Secure.SCREENSAVER_HOME_CONTROLS_ENABLED,
         Settings.Secure.SHOW_FIRST_CRASH_DIALOG_DEV_OPTION,
         Settings.Secure.VOLUME_DIALOG_DISMISS_TIMEOUT,
diff --git a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
index 0c5d3a426f5d..6b0d6fab215b 100644
--- a/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
+++ b/packages/SettingsProvider/src/android/provider/settings/validators/SecureSettingsValidators.java
@@ -225,6 +225,7 @@ public class SecureSettingsValidators {
         VALIDATORS.put(Secure.SCREENSAVER_COMPONENTS, COMMA_SEPARATED_COMPONENT_LIST_VALIDATOR);
         VALIDATORS.put(Secure.SCREENSAVER_ACTIVATE_ON_DOCK, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.SCREENSAVER_ACTIVATE_ON_SLEEP, BOOLEAN_VALIDATOR);
+        VALIDATORS.put(Secure.SCREENSAVER_ACTIVATE_ALWAYS, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.SCREENSAVER_HOME_CONTROLS_ENABLED, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.SHOW_FIRST_CRASH_DIALOG_DEV_OPTION, BOOLEAN_VALIDATOR);
         VALIDATORS.put(Secure.VOLUME_DIALOG_DISMISS_TIMEOUT, NON_NEGATIVE_INTEGER_VALIDATOR);
diff --git a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
index 7da858bac7a2..fc4bd7139666 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -1126,6 +1126,7 @@ class DatabaseHelper extends SQLiteOpenHelper {
                         com.android.internal.R.bool.config_dreamsActivatedOnDockByDefault);
                 loadBooleanSetting(stmt, Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP,
                         com.android.internal.R.bool.config_dreamsActivatedOnSleepByDefault);
+                loadBooleanSetting(stmt, Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS, 0);
                 loadStringSetting(stmt, Settings.Secure.SCREENSAVER_DEFAULT_COMPONENT,
                         com.android.internal.R.string.config_dreamsDefaultComponent);
 
diff --git a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProtoDumpUtil.java b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProtoDumpUtil.java
index 37eda3ebf9a8..40647072eb27 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProtoDumpUtil.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProtoDumpUtil.java
@@ -2530,6 +2530,9 @@ class SettingsProtoDumpUtil {
         dumpSetting(s, p,
                 Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP,
                 SecureSettingsProto.Screensaver.ACTIVATE_ON_SLEEP);
+        dumpSetting(s, p,
+                Settings.Secure.SCREENSAVER_ACTIVATE_ALWAYS,
+                SecureSettingsProto.Screensaver.ACTIVATE_ON_SLEEP); // Use same as SLEEP for now
         dumpSetting(s, p,
                 Settings.Secure.SCREENSAVER_DEFAULT_COMPONENT,
                 SecureSettingsProto.Screensaver.DEFAULT_COMPONENT);
-- 
