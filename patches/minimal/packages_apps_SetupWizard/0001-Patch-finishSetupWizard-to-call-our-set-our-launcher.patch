From 19b1a3d1032ebc4c635180ea9aa44b655d327555 Mon Sep 17 00:00:00 2001
From: Charlie Mizutsuki <charlie.mizutsuki@posteo.net>
Date: Thu, 14 Aug 2025 08:26:40 +0000
Subject: [PATCH] Patch finishSetupWizard to call our set our launcher and call
 it

Change-Id: I971f4632e54e77e4a1a1e1c49920a279d9c7edae
---
 exit_wizard.sh                                |  2 +
 .../setupwizard/util/SetupWizardUtils.java    | 78 +++++++++++++++++++
 2 files changed, 80 insertions(+)

diff --git a/exit_wizard.sh b/exit_wizard.sh
index 9c03eb0..0b86fae 100755
--- a/exit_wizard.sh
+++ b/exit_wizard.sh
@@ -7,6 +7,8 @@ adb root
 wait ${!}
 has_google_suw=$(adb shell pm list packages com.google.android.setupwizard)
 adb shell pm enable org.lineageos.setupwizard/.FinishActivity || true
+adb shell cmd package set-home-activity "app.inkos/.MainActivity"
+adb shell am start -a android.intent.action.MAIN -c android.intent.category.HOME
 if [[ ! -z "$has_google_suw" ]]
 then
     wait ${!}
diff --git a/src/org/lineageos/setupwizard/util/SetupWizardUtils.java b/src/org/lineageos/setupwizard/util/SetupWizardUtils.java
index 8315523..0a1a646 100644
--- a/src/org/lineageos/setupwizard/util/SetupWizardUtils.java
+++ b/src/org/lineageos/setupwizard/util/SetupWizardUtils.java
@@ -58,6 +58,9 @@ import org.lineageos.setupwizard.SetupWizardApp;
 
 import java.io.File;
 import java.util.List;
+import android.app.role.RoleManager;
+import java.util.concurrent.Executor;
+import java.util.function.Consumer;
 
 public class SetupWizardUtils {
 
@@ -67,6 +70,7 @@ public class SetupWizardUtils {
     private static final String GMS_SUW_PACKAGE = "com.google.android.setupwizard";
     private static final String GMS_TV_SUW_PACKAGE = "com.google.android.tungsten.setupwraith";
     private static final String UPDATER_PACKAGE = "org.lineageos.updater";
+    private static final String TARGET_HOME_PACKAGE = "app.inkos";
 
     private static final String UPDATE_RECOVERY_EXEC = "/vendor/bin/install-recovery.sh";
     private static final String CONFIG_HIDE_RECOVERY_UPDATE = "config_hideRecoveryUpdate";
@@ -171,6 +175,76 @@ public class SetupWizardUtils {
         }
     }
 
+    /**
+     * Set the default home activity to app.inkos/.MainActivity and launch it.
+     * This method should be called when the setup wizard finishes.
+     */
+    private static void setDefaultHomeAndLaunch(Context context) {
+        try {
+            // Check if the target package is installed
+            if (!isPackageInstalled(context, TARGET_HOME_PACKAGE)) {
+                Log.w(TAG, "Target package " + TARGET_HOME_PACKAGE + " is not installed, skipping home setup");
+                return;
+            }
+            
+            RoleManager roleManager = context.getSystemService(RoleManager.class);
+            if (roleManager == null) {
+                Log.e(TAG, "RoleManager not available");
+                return;
+            }
+
+            final int userId = UserHandle.myUserId();
+
+            // Set the default home activity
+            roleManager.addRoleHolderAsUser(RoleManager.ROLE_HOME, TARGET_HOME_PACKAGE, 0,
+                    UserHandle.of(userId), context.getMainExecutor(),
+                    new Consumer<Boolean>() {
+                        @Override
+                        public void accept(Boolean success) {
+                            if (success) {
+                                Log.i(TAG, "Successfully set " + TARGET_HOME_PACKAGE + " as default home");
+                                // Launch the home activity
+                                launchHomeActivity(context);
+                            } else {
+                                Log.e(TAG, "Failed to set " + TARGET_HOME_PACKAGE + " as default home");
+                            }
+                        }
+                    });
+
+        } catch (Exception e) {
+            Log.e(TAG, "Error setting default home activity", e);
+        }
+    }
+
+    /**
+     * Launch the home activity with android.intent.action.MAIN and android.intent.category.HOME.
+     */
+    private static void launchHomeActivity(Context context) {
+        try {
+            Intent homeIntent = new Intent(Intent.ACTION_MAIN);
+            homeIntent.addCategory(Intent.CATEGORY_HOME);
+            homeIntent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+            
+            // Try to launch the specific target package first
+            homeIntent.setPackage(TARGET_HOME_PACKAGE);
+            try {
+                context.startActivity(homeIntent);
+                Log.i(TAG, "Launched " + TARGET_HOME_PACKAGE + " as home activity");
+                return;
+            } catch (Exception e) {
+                Log.w(TAG, "Failed to launch " + TARGET_HOME_PACKAGE + ", falling back to system default", e);
+            }
+            
+            // Fallback to system default home
+            homeIntent.setPackage(null);
+            context.startActivity(homeIntent);
+            Log.i(TAG, "Launched system default home activity");
+            
+        } catch (Exception e) {
+            Log.e(TAG, "Error launching home activity", e);
+        }
+    }
+
     public static void finishSetupWizard(BaseSetupWizardActivity context) {
         if (LOGV) {
             Log.v(TAG, "finishSetupWizard");
@@ -198,6 +272,10 @@ public class SetupWizardUtils {
         WallpaperManager.getInstance(context).forgetLoadedWallpaper();
         disableHome(context);
         enableStatusBar();
+
+        // Set default home activity and launch it before finishing
+        setDefaultHomeAndLaunch(context);
+
         context.finishAffinity();
         context.nextAction(RESULT_SKIP);
         Log.i(TAG, "Setup complete!");
-- 
