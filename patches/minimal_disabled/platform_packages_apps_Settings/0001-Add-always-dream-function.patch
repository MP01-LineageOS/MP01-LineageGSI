From db905fcfe88ab628240f9056dc056ef41a95f9a8 Mon Sep 17 00:00:00 2001
From: Charlie Mizutsuki <charlie.mizutsuki@posteo.net>
Date: Mon, 11 Aug 2025 09:20:33 +0000
Subject: [PATCH] Add always dream function

Change-Id: I09a3e79665ce1aa890951484c791fc9ed0240a7c
---
 res/values/arrays.xml                             | 4 ++++
 res/values/strings.xml                            | 2 ++
 src/com/android/settings/dream/DreamSettings.java | 8 ++++++++
 3 files changed, 14 insertions(+)

diff --git a/res/values/arrays.xml b/res/values/arrays.xml
index febdb0412a4..10bdac1f1cd 100644
--- a/res/values/arrays.xml
+++ b/res/values/arrays.xml
@@ -1038,6 +1038,7 @@
     <string-array name="when_to_start_screensaver_entries_no_battery" translatable="false">
         <item>@string/screensaver_settings_summary_sleep</item>
         <item>@string/screensaver_settings_summary_dock_and_charging</item>
+        <item>@string/screensaver_settings_summary_always</item>
     </string-array>
 
     <!-- Values for screensaver "When to start" for devices that do not support screensavers
@@ -1045,18 +1046,21 @@
     <string-array name="when_to_start_screensaver_values_no_battery" translatable="false">
         <item>while_charging_only</item>
         <item>while_docked_only</item>
+        <item>always_when_locked</item>
     </string-array>
 
     <string-array name="when_to_start_screensaver_entries" translatable="false">
         <item>@string/screensaver_settings_summary_sleep</item>
         <item>@string/screensaver_settings_summary_dock</item>
         <item>@string/screensaver_settings_summary_either_long</item>
+        <item>@string/screensaver_settings_summary_always</item>
     </string-array>
 
     <string-array name="when_to_start_screensaver_values" translatable="false">
         <item>while_charging_only</item>
         <item>while_docked_only</item>
         <item>either_charging_or_docked</item>
+        <item>always_when_locked</item>
     </string-array>
 
     <string-array name="zen_mode_contacts_calls_entries" translatable="false">
diff --git a/res/values/strings.xml b/res/values/strings.xml
index fd09a1f8c9a..32d5e749ede 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -3101,6 +3101,8 @@
     <string name="screensaver_settings_summary_dock">While docked</string>
     <!-- Display settings screen, summary fragment for screen saver options, activated never [CHAR LIMIT=35] -->
     <string name="screensaver_settings_summary_never">Never</string>
+    <!-- Display settings screen, summary fragment for screen saver options, activated always when locked [CHAR LIMIT=35] -->
+    <string name="screensaver_settings_summary_always">Always when locked</string>
     <!-- Display settings screen, summary for screen saver options, screen saver is turned on [CHAR LIMIT=50] -->
     <string name="screensaver_settings_summary_on">
         On / <xliff:g id="screen_saver" example="Art gallery">%1$s</xliff:g>
diff --git a/src/com/android/settings/dream/DreamSettings.java b/src/com/android/settings/dream/DreamSettings.java
index 4854fc6b578..5bb09852163 100644
--- a/src/com/android/settings/dream/DreamSettings.java
+++ b/src/com/android/settings/dream/DreamSettings.java
@@ -17,6 +17,7 @@
 package com.android.settings.dream;
 
 import static com.android.settings.dream.DreamMainSwitchPreferenceController.MAIN_SWITCH_PREF_KEY;
+import static com.android.settingslib.dream.DreamBackend.ALWAYS;
 import static com.android.settingslib.dream.DreamBackend.EITHER;
 import static com.android.settingslib.dream.DreamBackend.NEVER;
 import static com.android.settingslib.dream.DreamBackend.WHILE_CHARGING;
@@ -58,6 +59,7 @@ public class DreamSettings extends DashboardFragment implements OnCheckedChangeL
     static final String WHILE_DOCKED_ONLY = "while_docked_only";
     static final String EITHER_CHARGING_OR_DOCKED = "either_charging_or_docked";
     static final String NEVER_DREAM = "never";
+    static final String ALWAYS_WHEN_LOCKED = "always_when_locked";
 
     private MainSwitchPreference mMainSwitchPreference;
     private Button mPreviewButton;
@@ -80,6 +82,8 @@ public class DreamSettings extends DashboardFragment implements OnCheckedChangeL
                 return WHILE_DOCKED;
             case EITHER_CHARGING_OR_DOCKED:
                 return EITHER;
+            case ALWAYS_WHEN_LOCKED:
+                return ALWAYS;
             case NEVER_DREAM:
             default:
                 return NEVER;
@@ -94,6 +98,8 @@ public class DreamSettings extends DashboardFragment implements OnCheckedChangeL
                 return WHILE_DOCKED_ONLY;
             case EITHER:
                 return EITHER_CHARGING_OR_DOCKED;
+            case ALWAYS:
+                return ALWAYS_WHEN_LOCKED;
             case NEVER:
             default:
                 return NEVER_DREAM;
@@ -110,6 +116,8 @@ public class DreamSettings extends DashboardFragment implements OnCheckedChangeL
                         : R.string.screensaver_settings_summary_dock_and_charging;
             case EITHER:
                 return R.string.screensaver_settings_summary_either_long;
+            case ALWAYS:
+                return R.string.screensaver_settings_summary_always;
             case NEVER:
             default:
                 return R.string.screensaver_settings_summary_never;
-- 
2.43.0

