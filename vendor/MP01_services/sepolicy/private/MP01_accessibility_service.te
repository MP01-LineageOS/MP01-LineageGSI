# sepolicy/private/MP01_accessibility_service.te

type MP01_accessibility_service, domain;
app_domain(MP01_accessibility_service)

# Allow accessibility service to access system services
allow MP01_accessibility_service app_api_service:service_manager find;
allow MP01_accessibility_service accessibility_service:service_manager find;

# Allow the accessibility service to manage system settings
allow MP01_accessibility_service system_app_data_file:dir create_dir_perms;
allow MP01_accessibility_service system_app_data_file:file create_file_perms;

# Allow access to system properties
set_prop(MP01_accessibility_service, system_prop)

# Access to overlay display
allow MP01_accessibility_service surfaceflinger_service:service_manager find;